{
  "name": "uatf-informatica",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests scripts package.json tsconfig.json next.config.ts README.md",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@libsql/client": "0.18.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
